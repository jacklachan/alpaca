# NEVER commit the real file. Keys live in the environment only.
# Two accounts: dev for all testing, scored for the competition.

ALPACA_ENV=dev                  # dev | scored
ALPACA_PAPER_TRADE=true         # process refuses to boot if this is not true

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

ANTHROPIC_API_KEY=

DISCORD_WEBHOOK_URL=            # heartbeat, kill-switch alerts, journal anchors
