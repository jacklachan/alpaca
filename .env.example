# Template only. NEVER put real values here -- this file IS tracked by git.
# Real credentials go in .env, which is gitignored.
#
# IMPORTANT: keep every comment on its OWN line.
# systemd's EnvironmentFile parser keeps inline '#' comments as part of the
# value ("dev  # note" stays "dev  # note"), python-dotenv strips them, and
# load_dotenv() does not override what systemd already set. That mismatch once
# silently disabled the scored-account safety checks in production while every
# hand test passed. `python -m glassbox.preflight` now refuses to start on it.

# dev | scored
ALPACA_ENV=dev

# Must be exactly "true". The process refuses to boot otherwise.
ALPACA_PAPER_TRADE=true

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Non-secret account numbers returned by Alpaca's account endpoint. Both are
# required and must differ; ALPACA_ENV selects which exact ID must be returned.
ALPACA_EXPECTED_DEV_ACCOUNT_ID=
ALPACA_EXPECTED_SCORED_ACCOUNT_ID=

# Optional. Without it scored cycles abstain; no fallback authors a scored trade.
ANTHROPIC_API_KEY=

# Optional but strongly recommended: heartbeat, kill-switch alerts,
# and journal anchors that carry a timestamp we do not control.
DISCORD_WEBHOOK_URL=

# Optional. Set to 1 to require a clean, reviewed, options-only, paper-bound
# commit before a scored run may start. Refuses on a dirty tree, a live
# endpoint, a missing account binding, or a non-options-only strategy set.
GLASSBOX_RELEASE_GATE=0
